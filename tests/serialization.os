&ТестовыйНабор
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&Тест
&Тег("serialization")
&ОтображаемоеИмя("Сериализует базовые скаляры в соответствиях")
Процедура СериализуетБазовыеСкалярыВСоответствиях() Экспорт
	Данные = Новый Соответствие();
	Данные.Вставить("name", "builder:latest");
	Данные.Вставить("count", 3);
	Данные.Вставить("active", Истина);
	Данные.Вставить("empty", "");
	Данные.Вставить("nothing", Неопределено);
	
	ОжидаемыйYaml = Строки(
		"name: ""builder:latest""",
		"count: 3",
		"active: true",
		"empty: """"",
		"nothing: null");
	
	ПроверитьСериализацию(Данные, ОжидаемыйYaml);
КонецПроцедуры

&Тест
&Тег("serialization")
&ОтображаемоеИмя("Сериализует одноэлементные коллекции с новой строки")
Процедура СериализуетОдноэлементныеКоллекцииСНовойСтроки() Экспорт
	Пайп = Новый Соответствие();
	
	Стадии = Новый Массив();
	Стадии.Добавить("build");
	Пайп.Вставить("stages", Стадии);
	
	ВложенныйОбъект = Новый Соответствие();
	ВложенныйОбъект.Вставить("name", "builder:latest");
	Пайп.Вставить("image", ВложенныйОбъект);
	
	ОжидаемыйYaml = Строки(
		"stages:",
		"  - build",
		"image:",
		"  name: ""builder:latest""");
	
	ПроверитьСериализацию(Пайп, ОжидаемыйYaml);
КонецПроцедуры

&Тест
&Тег("serialization")
&ОтображаемоеИмя("Сериализует массивы скаляров")
Процедура СериализуетМассивыСкаляров() Экспорт
	Данные = Новый Соответствие();
	
	Значения = Новый Массив();
	Значения.Добавить("build");
	Значения.Добавить("test");
	Значения.Добавить(10);
	Значения.Добавить(Ложь);
	Данные.Вставить("stages", Значения);
	
	ОжидаемыйYaml = Строки(
		"stages:",
		"  - build",
		"  - test",
		"  - 10",
		"  - false");
	
	ПроверитьСериализацию(Данные, ОжидаемыйYaml);
КонецПроцедуры

&Тест
&Тег("serialization")
&ОтображаемоеИмя("Сериализует вложенные соответствия и массивы")
Процедура СериализуетВложенныеСоответствияИМассивы() Экспорт
	Данные = Новый Соответствие();
	Задачи = Новый Массив();
	
	Задача = Новый Соответствие();
	Задача.Вставить("name", "build");
	
	Скрипт = Новый Массив();
	Скрипт.Добавить("opm install");
	Скрипт.Добавить("oneunit e");
	Задача.Вставить("script", Скрипт);
	
	Задачи.Добавить(Задача);
	Данные.Вставить("jobs", Задачи);
	
	ОжидаемыйYaml = Строки(
		"jobs:",
		"  - name: build",
		"    script:",
		"      - opm install",
		"      - oneunit e");
	
	ПроверитьСериализацию(Данные, ОжидаемыйYaml);
КонецПроцедуры

&Тест
&Тег("serialization")
&ОтображаемоеИмя("Сериализует пустые коллекции в flow-форме")
Процедура СериализуетПустыеКоллекцииВFlowФорме() Экспорт
	Данные = Новый Соответствие();
	Данные.Вставить("emptyArray", Новый Массив());
	Данные.Вставить("emptyMap", Новый Соответствие());
	
	ОжидаемыйYaml = Строки(
		"emptyArray: []",
		"emptyMap: {}");
	
	ПроверитьСериализацию(Данные, ОжидаемыйYaml);
КонецПроцедуры

&Тест
&Тег("serialization")
&ОтображаемоеИмя("Сериализует многострочные строки блоком")
Процедура СериализуетМногострочныеСтрокиБлоком() Экспорт
	Данные = Новый Соответствие();
	Данные.Вставить("script", "line 1" + Символы.ПС + "line 2");
	
	ОжидаемыйYaml = Строки(
		"script: |",
		"  line 1",
		"  line 2");
	
	ПроверитьСериализацию(Данные, ОжидаемыйYaml);
КонецПроцедуры

&Тест
&Тег("serialization")
&ОтображаемоеИмя("Сериализует верхнеуровневый массив как один документ")
Процедура СериализуетВерхнеуровневыйМассивКакОдинДокумент() Экспорт
	Данные = Новый Массив();
	Данные.Добавить("build");
	Данные.Добавить("test");
	
	ОжидаемыйYaml = Строки(
		"- build",
		"- test");
	
	ПроверитьСериализацию(Данные, ОжидаемыйYaml);
КонецПроцедуры

&Тест
&Тег("serialization")
&ОтображаемоеИмя("Сериализует несколько документов с разделителями")
Процедура СериализуетНесколькоДокументовСРазделителями() Экспорт
	Документы = Новый Массив();
	
	ПервыйДокумент = Новый Соответствие();
	ПервыйДокумент.Вставить("name", "first");
	Документы.Добавить(ПервыйДокумент);
	
	ВторойДокумент = Новый Соответствие();
	ВторойДокумент.Вставить("name", "second");
	
	Элементы = Новый Массив();
	Элементы.Добавить("one");
	ВторойДокумент.Вставить("items", Элементы);
	Документы.Добавить(ВторойДокумент);
	
	ОжидаемыйYaml = Строки(
		"---",
		"name: first",
		"---",
		"name: second",
		"items:",
		"  - one");
	
	ПроверитьСериализациюДокументов(Документы, ОжидаемыйYaml);
КонецПроцедуры

Процедура ПроверитьСериализацию(Значение, ОжидаемыйYaml)
	Парсер = ТестовыеУтилиты.СоздатьЭкземплярПарсера();
	ФактическийYaml = НормализоватьПереносы(Парсер.ЗаписатьYaml(Значение));
	
	Ожидаем.Что(ФактическийYaml).Равно(ОжидаемыйYaml);
КонецПроцедуры

Процедура ПроверитьСериализациюДокументов(Документы, ОжидаемыйYaml)
	Парсер = ТестовыеУтилиты.СоздатьЭкземплярПарсера();
	ФактическийYaml = НормализоватьПереносы(Парсер.ЗаписатьДокументыYaml(Документы));
	
	Ожидаем.Что(ФактическийYaml).Равно(ОжидаемыйYaml);
КонецПроцедуры

Функция Строки(
	Строка1,
	Строка2 = Неопределено,
	Строка3 = Неопределено,
	Строка4 = Неопределено,
	Строка5 = Неопределено,
	Строка6 = Неопределено,
	Строка7 = Неопределено)
	
	Результат = Строка1;
	СтрокиДляДобавления = Новый Массив();
	СтрокиДляДобавления.Добавить(Строка2);
	СтрокиДляДобавления.Добавить(Строка3);
	СтрокиДляДобавления.Добавить(Строка4);
	СтрокиДляДобавления.Добавить(Строка5);
	СтрокиДляДобавления.Добавить(Строка6);
	СтрокиДляДобавления.Добавить(Строка7);
	
	Для Каждого СтрокаДляДобавления Из СтрокиДляДобавления Цикл
		Если СтрокаДляДобавления <> Неопределено Тогда
			Результат = Результат + Символы.ПС + СтрокаДляДобавления;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

Функция НормализоватьПереносы(Значение)
	Возврат СтрЗаменить(Значение, Символы.ВК, Символы.ПС);
КонецФункции
