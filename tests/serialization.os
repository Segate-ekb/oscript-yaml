&Тест
&Тег("serialization")
&ОтображаемоеИмя("Сериализует базовые скаляры в соответствиях")
Процедура СериализуетБазовыеСкалярыВСоответствиях() Экспорт
	Данные = Новый Соответствие();
	Данные.Вставить("name", "builder:latest");
	Данные.Вставить("count", 3);
	Данные.Вставить("active", Истина);
	Данные.Вставить("empty", "");
	Данные.Вставить("nothing", Неопределено);
	
	ОжидаемыйYaml = Строки(
		"name: ""builder:latest""",
		"count: 3",
		"active: true",
		"empty: """"",
		"nothing: null");
	
	ПроверитьСериализацию(Данные, ОжидаемыйYaml);
КонецПроцедуры

&Тест
&Тег("serialization")
&ОтображаемоеИмя("Сериализует одноэлементные коллекции с новой строки")
