&Тест
&Тег("serialization")
&ОтображаемоеИмя("Сериализует несколько документов с разделителями")
Процедура СериализуетНесколькоДокументовСРазделителями() Экспорт
	Документы = Новый Массив();
	
	ПервыйДокумент = Новый Соответствие();
	ПервыйДокумент.Вставить("name", "first");
	Документы.Добавить(ПервыйДокумент);
	
	ВторойДокумент = Новый Соответствие();
	ВторойДокумент.Вставить("name", "second");
	
	Элементы = Новый Массив();
	Элементы.Добавить("one");
	ВторойДокумент.Вставить("items", Элементы);
	Документы.Добавить(ВторойДокумент);
	
	ОжидаемыйYaml = Строки(
		"---",
		"name: first",
		"---",
		"name: second",
		"items:",
		"  - one");
	
	ПроверитьСериализациюДокументов(Документы, ОжидаемыйYaml);
КонецПроцедуры

