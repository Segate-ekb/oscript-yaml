&Тест
&Тег("serialization")
&ОтображаемоеИмя("Сериализует комплексный pipeline")
Процедура СериализуетКомплексныйPipeline() Экспорт
	Данные = Новый Соответствие();
	
	Стадии = Новый Массив();
	Стадии.Добавить("build");
	Стадии.Добавить("test");
	Данные.Вставить("stages", Стадии);
	
	Переменные = Новый Соответствие();
	Переменные.Вставить("IMAGE", "repo/image:latest");
	Переменные.Вставить("DEBUG", "false");
	Данные.Вставить("variables", Переменные);
	
	Задачи = Новый Массив();
	
	Задача = Новый Соответствие();
	Задача.Вставить("name", "build");
	Задача.Вставить("stage", "build");
	
	Скрипт = Новый Массив();
	Скрипт.Добавить("opm install");
	Скрипт.Добавить("oneunit e");
	Задача.Вставить("script", Скрипт);
	
	Артефакты = Новый Соответствие();
	Пути = Новый Массив();
	Пути.Добавить("out");
	Артефакты.Вставить("paths", Пути);
	Задача.Вставить("artifacts", Артефакты);
	
	Задачи.Добавить(Задача);
	Данные.Вставить("jobs", Задачи);
	
	ОжидаемыйYaml = Строки(
		"stages:",
		"  - build",
		"  - test",
		"variables:",
		"  IMAGE: ""repo/image:latest""",
		"  DEBUG: ""false""",
		"jobs:",
		"  - name: build",
		"    stage: build",
		"    script:",
		"      - opm install",
		"      - oneunit e",
		"    artifacts:",
		"      paths:",
		"        - out");
	
	ПроверитьСериализацию(Данные, ОжидаемыйYaml);
КонецПроцедуры

Процедура ПроверитьСериализацию(Значение, ОжидаемыйYaml)
	Парсер = ТестовыеУтилиты.СоздатьЭкземплярПарсера();
	ФактическийYaml = НормализоватьПереносы(Парсер.ЗаписатьYaml(Значение));
	
	Ожидаем.Что(ФактическийYaml).Равно(ОжидаемыйYaml);
КонецПроцедуры

Процедура ПроверитьСериализациюДокументов(Документы, ОжидаемыйYaml)
	Парсер = ТестовыеУтилиты.СоздатьЭкземплярПарсера();
	ФактическийYaml = НормализоватьПереносы(Парсер.ЗаписатьДокументыYaml(Документы));
	
	Ожидаем.Что(ФактическийYaml).Равно(ОжидаемыйYaml);
КонецПроцедуры

Функция Строки(
	Строка1,
	Строка2 = Неопределено,
	Строка3 = Неопределено,
	Строка4 = Неопределено,
	Строка5 = Неопределено,
	Строка6 = Неопределено,
	Строка7 = Неопределено,
	Строка8 = Неопределено,
	Строка9 = Неопределено,
	Строка10 = Неопределено,
	Строка11 = Неопределено,
	Строка12 = Неопределено,
	Строка13 = Неопределено,
	Строка14 = Неопределено,
	Строка15 = Неопределено,
	Строка16 = Неопределено,
	Строка17 = Неопределено,
	Строка18 = Неопределено,
	Строка19 = Неопределено,
	Строка20 = Неопределено)
	
	Результат = Строка1;
	СтрокиДляДобавления = Новый Массив();
	СтрокиДляДобавления.Добавить(Строка2);
	СтрокиДляДобавления.Добавить(Строка3);
	СтрокиДляДобавления.Добавить(Строка4);
	СтрокиДляДобавления.Добавить(Строка5);
	СтрокиДляДобавления.Добавить(Строка6);
	СтрокиДляДобавления.Добавить(Строка7);
	СтрокиДляДобавления.Добавить(Строка8);
	СтрокиДляДобавления.Добавить(Строка9);
	СтрокиДляДобавления.Добавить(Строка10);
	СтрокиДляДобавления.Добавить(Строка11);
	СтрокиДляДобавления.Добавить(Строка12);
	СтрокиДляДобавления.Добавить(Строка13);
	СтрокиДляДобавления.Добавить(Строка14);
	СтрокиДляДобавления.Добавить(Строка15);
	СтрокиДляДобавления.Добавить(Строка16);
	СтрокиДляДобавления.Добавить(Строка17);
	СтрокиДляДобавления.Добавить(Строка18);
	СтрокиДляДобавления.Добавить(Строка19);
	СтрокиДляДобавления.Добавить(Строка20);
	
	Для Каждого СтрокаДляДобавления Из СтрокиДляДобавления Цикл
		Если СтрокаДляДобавления <> Неопределено Тогда
			Результат = Результат + Символы.ПС + СтрокаДляДобавления;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

Функция НормализоватьПереносы(Значение)
	Возврат СтрЗаменить(Значение, Символы.ВК, Символы.ПС);
КонецФункции
