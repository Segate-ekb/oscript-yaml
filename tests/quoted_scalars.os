#Использовать "."

&ТестовыйНабор
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&Тест
&Тег("deserialization")
&ОтображаемоеИмя("Читает true, false, null и ~ в кавычках как строки")
Процедура ЧитаетСпециальныеЗначенияВКавычкахКакСтроки() Экспорт
	Парсер = ТестовыеУтилиты.СоздатьЭкземплярПарсера();

	Результат = Парсер.ПрочитатьYaml(Строки(
		"doubleTrue: ""true""",
		"singleTrue: 'true'",
		"doubleFalse: ""false""",
		"doubleNull: ""null""",
		"singleNull: 'NULL'",
		"doubleTilde: ""~"""));

	Ожидаем.Что(Результат["doubleTrue"]).Равно("true");
	Ожидаем.Что(Результат["singleTrue"]).Равно("true");
	Ожидаем.Что(Результат["doubleFalse"]).Равно("false");
	Ожидаем.Что(Результат["doubleNull"]).Равно("null");
	Ожидаем.Что(Результат["singleNull"]).Равно("NULL");
	Ожидаем.Что(Результат["doubleTilde"]).Равно("~");
КонецПроцедуры

&Тест
&Тег("deserialization")
&ОтображаемоеИмя("Читает true, false и null без кавычек как Булево и Неопределено")
Процедура ЧитаетСпециальныеЗначенияБезКавычек() Экспорт
	Парсер = ТестовыеУтилиты.СоздатьЭкземплярПарсера();

	Результат = Парсер.ПрочитатьYaml(Строки(
		"plainTrue: true",
		"plainFalse: false",
		"plainNull: null",
		"plainTilde: ~"));

	Ожидаем.Что(Результат["plainTrue"]).Равно(Истина);
	Ожидаем.Что(Результат["plainFalse"]).Равно(Ложь);
	Ожидаем.Что(Результат.Получить("plainNull")).Равно(Неопределено);
	Ожидаем.Что(Результат.Получить("plainTilde")).Равно(Неопределено);
	Ожидаем.Что(Результат.Количество()).Равно(4);
КонецПроцедуры

&Тест
&Тег("deserialization")
&ОтображаемоеИмя("Читает специальные значения в кавычках как строки в последовательностях и flow-коллекциях")
Процедура ЧитаетСпециальныеЗначенияВКавычкахВКоллекциях() Экспорт
	Парсер = ТестовыеУтилиты.СоздатьЭкземплярПарсера();

	Результат = Парсер.ПрочитатьYaml(Строки(
		"block:",
		"  - ""true""",
		"flowSequence: [""false"", 'null', true]",
		"flowMapping: {key: ""true""}"));

	Ожидаем.Что(Результат["block"][0]).Равно("true");
	Ожидаем.Что(Результат["flowSequence"][0]).Равно("false");
	Ожидаем.Что(Результат["flowSequence"][1]).Равно("null");
	Ожидаем.Что(Результат["flowSequence"][2]).Равно(Истина);
	Ожидаем.Что(Результат["flowMapping"]["key"]).Равно("true");
КонецПроцедуры

&Тест
&Тег("deserialization")
&ОтображаемоеИмя("Читает обратно строки true, false и null, записанные сериализатором")
Процедура ЧитаетОбратноЗаписанныеСтрокиСпециальныхЗначений() Экспорт
	Парсер = ТестовыеУтилиты.СоздатьЭкземплярПарсера();
	Данные = Новый Соответствие();
	Данные.Вставить("boolString", "false");
	Данные.Вставить("nullString", "null");
	Данные.Вставить("boolValue", Истина);

	Результат = Парсер.ПрочитатьYaml(Парсер.ЗаписатьYaml(Данные));

	Ожидаем.Что(Результат["boolString"]).Равно("false");
	Ожидаем.Что(Результат["nullString"]).Равно("null");
	Ожидаем.Что(Результат["boolValue"]).Равно(Истина);
КонецПроцедуры

Функция Строки(
	Строка1,
	Строка2 = Неопределено,
	Строка3 = Неопределено,
	Строка4 = Неопределено,
	Строка5 = Неопределено,
	Строка6 = Неопределено)

	Части = Новый Массив();
	ДобавитьСтроку(Части, Строка1);
	ДобавитьСтроку(Части, Строка2);
	ДобавитьСтроку(Части, Строка3);
	ДобавитьСтроку(Части, Строка4);
	ДобавитьСтроку(Части, Строка5);
	ДобавитьСтроку(Части, Строка6);

	Возврат СтрСоединить(Части, Символы.ПС);
КонецФункции

Процедура ДобавитьСтроку(Части, Строка)
	Если Строка <> Неопределено Тогда
		Части.Добавить(Строка);
	КонецЕсли;
КонецПроцедуры
