// Модуль для сериализации данных в формат YAML

// Основная функция сериализации
//
// Параметры:
//   Значение - Произвольный - данные для сериализации
//   УровеньОтступа - Число - текущий уровень отступа (по умолчанию 0)
//
// Возвращаемое значение:
//   Строка - YAML представление данных
//
Функция Сериализовать(Знач Значение, УровеньОтступа = 0) Экспорт
	
	Возврат СериализоватьЗначение(Значение, УровеньОтступа);
	
КонецФункции

Функция СериализоватьДокументы(Знач Документы) Экспорт
	
	Если ТипЗнч(Документы) <> Тип("Массив") Тогда
		ВызватьИсключение "Для сериализации нескольких документов нужно передать массив документов";
	КонецЕсли;
	
	Результат = "";
	
	Для Каждого Документ Из Документы Цикл
		Результат = ДобавитьСтроку(Результат, "---" + Символы.ПС + СериализоватьЗначение(Документ, 0));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция СериализоватьЗначение(Знач Значение, УровеньОтступа)
	
	Если Значение = Неопределено Тогда
		Возврат "null";
	КонецЕсли;
	
	ТипЗначения = ТипЗнч(Значение);
	
	Если ТипЗначения = Тип("Массив") Тогда
		Возврат СериализоватьМассив(Значение, УровеньОтступа);
	ИначеЕсли ЭтоТипОбъекта(ТипЗначения) Тогда
		Возврат СериализоватьОбъект(Значение, УровеньОтступа);
	ИначеЕсли ТипЗначения = Тип("Строка") И ЭтоМногострочнаяСтрока(Значение) Тогда
		Возврат СериализоватьМногострочнуюСтроку(Значение, УровеньОтступа);
	Иначе
		Возврат СериализоватьСкаляр(Значение);
	КонецЕсли;
	
КонецФункции

Функция СериализоватьСкаляр(Знач Значение)
	
	Если Значение = Неопределено Тогда
		Возврат "null";
	КонецЕсли;
	
	ТипЗначения = ТипЗнч(Значение);
	
	Если ТипЗначения = Тип("Строка") Тогда
		Возврат СериализоватьСтроку(Значение);
	ИначеЕсли ТипЗначения = Тип("Число") Тогда
		Возврат СериализоватьЧисло(Значение);
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		Возврат СериализоватьБулево(Значение);
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Возврат СериализоватьJSON(Значение);
	Иначе
		Попытка
			Возврат СериализоватьJSON(Значение);
		Исключение
			Возврат СериализоватьСтроку(Строка(Значение));
		КонецПопытки;
	КонецЕсли;
	
КонецФункции

// Сериализация строки
//
// Параметры:
//   Значение - Строка - строка для сериализации
//
// Возвращаемое значение:
//   Строка - YAML представление строки
//
Функция СериализоватьСтроку(Значение)
	
	Если Значение = "" Тогда
		Возврат """""";
	КонецЕсли;
	
	Если ТребуетсяЗаключениеВКавычки(Значение) Тогда
		Возврат СериализоватьJSON(Значение);
	Иначе
		Возврат Значение;
	КонецЕсли;
	
КонецФункции

Функция СериализоватьJSON(Значение)
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Значение);
	
	Возврат ЗаписьJSON.Закрыть();
	
КонецФункции

// Сериализация многострочной строки
//
// Параметры:
//   Значение - Строка - многострочная строка для сериализации
//   УровеньОтступа - Число - текущий уровень отступа
//
// Возвращаемое значение:
//   Строка - YAML представление многострочной строки
//
Функция СериализоватьМногострочнуюСтроку(Значение, УровеньОтступа)
	
	НормализованноеЗначение = НормализоватьПереносыСтрок(Значение);
	Строки = СтрРазделить(НормализованноеЗначение, Символы.ПС, Истина);
	ОтступСтроки = ПолучитьОтступ(УровеньОтступа + 1);
	
	Результат = "|";
	Для Каждого СтрокаЗначения Из Строки Цикл
		Результат = Результат + Символы.ПС + ОтступСтроки + СтрокаЗначения;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Сериализация числа
//
// Параметры:
//   Значение - Число - число для сериализации
//
// Возвращаемое значение:
//   Строка - YAML представление числа
//
Функция СериализоватьЧисло(Значение)
	Если Значение = 0 Тогда
		Возврат "0";
	Иначе
		Возврат Формат(Значение, "ЧРД=.;ЧГ=");
	КонецЕсли;
КонецФункции

// Сериализация булевого значения
//
// Параметры:
//   Значение - Булево - булевое значение
//
// Возвращаемое значение:
//   Строка - YAML представление булевого значения
//
Функция СериализоватьБулево(Значение)
	Если Значение Тогда
		Возврат "true";
	Иначе
		Возврат "false";
	КонецЕсли;
КонецФункции

// Сериализация массива
//
// Параметры:
//   Массив - Массив - массив для сериализации
//   УровеньОтступа - Число - текущий уровень отступа
//
// Возвращаемое значение:
//   Строка - YAML представление массива
//
Функция СериализоватьМассив(Массив, УровеньОтступа = 0)
	
	Если Массив.Количество() = 0 Тогда
		Возврат "[]";
	КонецЕсли;
	
	Результат = "";
	Отступ = ПолучитьОтступ(УровеньОтступа);
	
	Для Каждого Элемент Из Массив Цикл
		Результат = ДобавитьСтроку(Результат, СериализоватьЭлементМассива(Элемент, Отступ, УровеньОтступа));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция СериализоватьЭлементМассива(Знач Элемент, Отступ, УровеньОтступа)
	
	Если ЭтоПустаяКоллекция(Элемент) Или ЭтоСкалярДляСтроки(Элемент) Тогда
		Возврат Отступ + "- " + СериализоватьСкалярИлиПустуюКоллекцию(Элемент);
	КонецЕсли;
	
	ТипЭлемента = ТипЗнч(Элемент);
	
	Если ТипЭлемента = Тип("Строка") Тогда
		Возврат Отступ + "- " + СериализоватьМногострочнуюСтроку(Элемент, УровеньОтступа);
	ИначеЕсли ЭтоТипОбъекта(ТипЭлемента) Тогда
		Возврат СериализоватьОбъектВЭлементеМассива(Элемент, Отступ, УровеньОтступа);
	ИначеЕсли ТипЭлемента = Тип("Массив") Тогда
		Возврат Отступ + "-" + Символы.ПС + СериализоватьМассив(Элемент, УровеньОтступа + 1);
	Иначе
		Возврат Отступ + "- " + СериализоватьСкаляр(Элемент);
	КонецЕсли;
	
КонецФункции

Функция СериализоватьОбъектВЭлементеМассива(Объект, Отступ, УровеньОтступа)
	
	ОтступДочернегоОбъекта = ПолучитьОтступ(УровеньОтступа + 1);
	СериализованныйОбъект = СериализоватьОбъект(Объект, УровеньОтступа + 1);
	СтрокиОбъекта = СтрРазделить(СериализованныйОбъект, Символы.ПС, Истина);
	
	ПерваяСтрока = УбратьНачальныйОтступ(СтрокиОбъекта[0], ОтступДочернегоОбъекта);
	Результат = Отступ + "- " + ПерваяСтрока;
	
	Для Индекс = 1 По СтрокиОбъекта.Количество() - 1 Цикл
		Результат = Результат + Символы.ПС + СтрокиОбъекта[Индекс];
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Сериализация объекта
//
// Параметры:
//   Объект - Соответствие, Структура - объект для сериализации
//   УровеньОтступа - Число - текущий уровень отступа
//
// Возвращаемое значение:
//   Строка - YAML представление объекта
//
Функция СериализоватьОбъект(Объект, УровеньОтступа = 0)
	
	Если Объект.Количество() = 0 Тогда
		Возврат "{}";
	КонецЕсли;
	
	Результат = "";
	Отступ = ПолучитьОтступ(УровеньОтступа);
	
	Для Каждого КлючЗначение Из Объект Цикл
		Ключ = СериализоватьКлюч(КлючЗначение.Ключ);
		Значение = КлючЗначение.Значение;
		
		Результат = ДобавитьСтроку(Результат, СериализоватьСвойствоОбъекта(Ключ, Значение, Отступ, УровеньОтступа));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция СериализоватьСвойствоОбъекта(Ключ, Значение, Отступ, УровеньОтступа)
	
	Если ЭтоПустаяКоллекция(Значение) Или ЭтоСкалярДляСтроки(Значение) Тогда
		Возврат Отступ + Ключ + ": " + СериализоватьСкалярИлиПустуюКоллекцию(Значение);
	КонецЕсли;
	
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат Отступ + Ключ + ": " + СериализоватьМногострочнуюСтроку(Значение, УровеньОтступа);
	Иначе
		Возврат Отступ + Ключ + ":" + Символы.ПС + СериализоватьЗначение(Значение, УровеньОтступа + 1);
	КонецЕсли;
	
КонецФункции

Функция СериализоватьСкалярИлиПустуюКоллекцию(Знач Значение)
	
	Если ЭтоПустаяКоллекция(Значение) Тогда
		Если ТипЗнч(Значение) = Тип("Массив") Тогда
			Возврат "[]";
		Иначе
			Возврат "{}";
		КонецЕсли;
	Иначе
		Возврат СериализоватьСкаляр(Значение);
	КонецЕсли;
	
КонецФункции

// Сериализация ключа
//
// Параметры:
//   Ключ - Произвольный - ключ для сериализации
//
// Возвращаемое значение:
//   Строка - YAML представление ключа
//
Функция СериализоватьКлюч(Ключ)
	
	Возврат СериализоватьСкаляр(Ключ);
	
КонецФункции

Функция ЭтоСкалярДляСтроки(Значение)
	
	Если Значение = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	
	ТипЗначения = ТипЗнч(Значение);
	
	Если ТипЗначения = Тип("Массив") Или ЭтоТипОбъекта(ТипЗначения) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ТипЗначения = Тип("Строка") Тогда
		Возврат НЕ ЭтоМногострочнаяСтрока(Значение);
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ЭтоПустаяКоллекция(Значение)
	
	Если Значение = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТипЗначения = ТипЗнч(Значение);
	
	Если ТипЗначения = Тип("Массив") Или ЭтоТипОбъекта(ТипЗначения) Тогда
		Возврат Значение.Количество() = 0;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

Функция ЭтоТипОбъекта(ТипЗначения)
	
	Возврат ТипЗначения = Тип("Структура") Или ТипЗначения = Тип("Соответствие");
	
КонецФункции

Функция ЭтоМногострочнаяСтрока(Значение)
	
	Возврат СтрНайти(Значение, Символы.ПС) > 0 Или СтрНайти(Значение, Символы.ВК) > 0;
	
КонецФункции

Функция НормализоватьПереносыСтрок(Значение)
	
	Результат = СтрЗаменить(Значение, Символы.ВК + Символы.ПС, Символы.ПС);
	Результат = СтрЗаменить(Результат, Символы.ВК, Символы.ПС);
	
	Возврат Результат;
	
КонецФункции

Функция ДобавитьСтроку(Результат, Строка)
	
	Если Результат = "" Тогда
		Возврат Строка;
	Иначе
		Возврат Результат + Символы.ПС + Строка;
	КонецЕсли;
	
КонецФункции

Функция УбратьНачальныйОтступ(Строка, Отступ)
	
	Если СтрНачинаетсяС(Строка, Отступ) Тогда
		Возврат Сред(Строка, СтрДлина(Отступ) + 1);
	Иначе
		Возврат СокрЛП(Строка);
	КонецЕсли;
	
КонецФункции

// Получение строки отступа
//
// Параметры:
//   УровеньОтступа - Число - уровень отступа
//
// Возвращаемое значение:
//   Строка - строка с соответствующим количеством пробелов
//
Функция ПолучитьОтступ(УровеньОтступа)
	
	Если УровеньОтступа <= 0 Тогда
		Возврат "";
	КонецЕсли;
	
	КоличествоПробелов = УровеньОтступа * 2;
	Результат = "";
	
	Пока СтрДлина(Результат) < КоличествоПробелов Цикл
		Результат = Результат + " ";
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Проверка, является ли строка числом
//
// Параметры:
//   Значение - Строка - строка для проверки
//
// Возвращаемое значение:
//   Булево - Истина, если строка представляет число
//
Функция ЭтоЧисло(Значение)
	
	ОчищенноеЗначение = СокрЛП(Значение);
	
	Если ОчищенноеЗначение = "" Тогда
		Возврат Ложь;
	КонецЕсли;
	
	РазрешенныеСимволы = "0123456789.-+";
	КоличествоТочек = 0;
	КоличествоЗнаков = 0;
	КоличествоЦифр = 0;
	
	Для Позиция = 1 По СтрДлина(ОчищенноеЗначение) Цикл
		Символ = Сред(ОчищенноеЗначение, Позиция, 1);
		
		Если СтрНайти(РазрешенныеСимволы, Символ) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		
		Если СтрНайти("0123456789", Символ) > 0 Тогда
			КоличествоЦифр = КоличествоЦифр + 1;
		ИначеЕсли Символ = "." Тогда
			КоличествоТочек = КоличествоТочек + 1;
		ИначеЕсли Символ = "-" Или Символ = "+" Тогда
			КоличествоЗнаков = КоличествоЗнаков + 1;
			Если Позиция > 1 Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат КоличествоЦифр > 0 И КоличествоТочек <= 1 И КоличествоЗнаков <= 1;
	
КонецФункции

// Проверка, требуется ли заключение строки в кавычки
//
// Параметры:
//   Значение - Строка - строка для проверки
//
// Возвращаемое значение:
//   Булево - Истина, если строку нужно заключить в кавычки
//
Функция ТребуетсяЗаключениеВКавычки(Значение)
	
	Если Значение = "" Тогда
		Возврат Истина;
	КонецЕсли;
	
	НижнийРегистр = НРег(СокрЛП(Значение));
	СпециальныеЗначения = Новый Массив;
	СпециальныеЗначения.Добавить("true");
	СпециальныеЗначения.Добавить("false");
	СпециальныеЗначения.Добавить("null");
	СпециальныеЗначения.Добавить("~");
	СпециальныеЗначения.Добавить("yes");
	СпециальныеЗначения.Добавить("no");
	СпециальныеЗначения.Добавить("on");
	СпециальныеЗначения.Добавить("off");
	
	Для Каждого СпециальноеЗначение Из СпециальныеЗначения Цикл
		Если НижнийРегистр = СпециальноеЗначение Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если ЭтоЧисло(Значение) Тогда
		Возврат Истина;
	КонецЕсли;
	
	СпециальныеСимволы = ":#@`|>{}[]!%&*";
	Для Индекс = 1 По СтрДлина(СпециальныеСимволы) Цикл
		Символ = Сред(СпециальныеСимволы, Индекс, 1);
		Если СтрНайти(Значение, Символ) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если Лев(Значение, 1) = " " Или Прав(Значение, 1) = " " Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если СтрНайти(Значение, Символы.ПС) > 0 Или СтрНайти(Значение, Символы.ВК) > 0
		Или СтрНайти(Значение, Символы.ВТаб) > 0 Или СтрНайти(Значение, """") > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции
