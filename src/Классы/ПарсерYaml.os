#Использовать "../internal"

Процедура ПриСозданииОбъекта() Экспорт
	
КонецПроцедуры

// Основная функция для чтения YAML-строки
//
// Параметры:
//   СтрокаYaml - Строка - YAML-строка для парсинга
//
// Возвращаемое значение:
//   Произвольный - распарсенная структура данных или скалярное значение
//
Функция ПрочитатьYaml(СтрокаYaml = "") Экспорт
	МассивДокументов = Десериализатор.Прочитать(СтрокаYaml);
	Если МассивДокументов.Количество() = 0 Тогда
		Возврат Неопределено; // Если нет документов, возвращаем Неопределено
	ИначеЕсли МассивДокументов.Количество() = 1 Тогда
		Возврат МассивДокументов[0];
	Иначе
		Возврат МассивДокументов;
	КонецЕсли;
КонецФункции

// Читает YAML из файла
//
// Параметры:
//   ПутьКФайлу - Строка - путь к YAML-файлу
//
// Возвращаемое значение:
//   Произвольный - распарсенная структура данных или скалярное значение
//
Функция ПрочитатьИзФайла(ПутьКФайлу) Экспорт
	ФайлYaml = Новый Файл(ПутьКФайлу);
	Если НЕ ФайлYaml.Существует() Тогда
		ВызватьИсключение "Файл не найден: " + ПутьКФайлу;
	КонецЕсли;

	ЧтениеТекста = Новый ЧтениеТекста(ПутьКФайлу, "UTF-8");
	СтрокаYaml = ЧтениеТекста.Прочитать();
	ЧтениеТекста.Закрыть();

	Возврат ПрочитатьYaml(СтрокаYaml);
КонецФункции

// YAML сериализатор
//
// Параметры:
//  Значение - Произвольный - Набор данных сериализуемых в формат;
//
// Возвращаемое значение:
//  Строка - Строка данных в формате YAML согласно содержимому входящих данных. 
//
Функция ЗаписатьYaml(Знач Значение) Экспорт
	
	Возврат Сериализатор.Сериализовать(Значение);

КонецФункции

// Записывает значение в YAML-файл
//
// Параметры:
//  ПутьКФайлу - Строка - путь к YAML-файлу;
//  Значение - Произвольный - набор данных сериализуемых в формат.
//
Процедура ЗаписатьВФайл(ПутьКФайлу, Знач Значение) Экспорт
	СтрокаYaml = ЗаписатьYaml(Значение);

	ЗаписьТекста = Новый ЗаписьТекста(ПутьКФайлу, "UTF-8");
	ЗаписьТекста.Записать(СтрокаYaml);
	ЗаписьТекста.Закрыть();
КонецПроцедуры

// YAML сериализатор нескольких документов
//
// Параметры:
//  Документы - Массив - документы, сериализуемые в один YAML-поток;
//
// Возвращаемое значение:
//  Строка - Строка данных в формате YAML согласно содержимому входящих документов.
//
Функция ЗаписатьДокументыYaml(Знач Документы) Экспорт
	
	Возврат Сериализатор.СериализоватьДокументы(Документы);

КонецФункции
