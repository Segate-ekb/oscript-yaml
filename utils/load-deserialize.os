#Использовать ".."

Функция БольшойYaml(КоличествоЭлементов)
	СтрокиYaml = Новый Массив();
	СтрокиYaml.Добавить("items:");
	
	Для Индекс = 1 По КоличествоЭлементов Цикл
		СтрокиYaml.Добавить("  - id: " + Строка(Индекс));
		СтрокиYaml.Добавить("    name: item-" + Строка(Индекс));
		СтрокиYaml.Добавить("    enabled: true");
		СтрокиYaml.Добавить("    labels:");
		СтрокиYaml.Добавить("      - build");
		СтрокиYaml.Добавить("      - test");
		СтрокиYaml.Добавить("    limits:");
		СтрокиYaml.Добавить("      cpu: " + Строка(Индекс % 16 + 1));
		СтрокиYaml.Добавить("      memory: " + Строка(Индекс % 64 + 128));
	КонецЦикла;
	
	Возврат СтрСоединить(СтрокиYaml, Символы.ПС);
КонецФункции

КоличествоЭлементов = 5000;
Парсер = Новый ПарсерYaml();
Yaml = БольшойYaml(КоличествоЭлементов);
Документ = Парсер.ПрочитатьYaml(Yaml);
Элементы = Документ.Получить("items");

Если Элементы.Количество() <> КоличествоЭлементов Тогда
	ВызватьИсключение СтрШаблон(
		"Ожидалось %1 элементов, получено %2",
		КоличествоЭлементов,
		Элементы.Количество());
КонецЕсли;

Сообщить("items=" + Строка(КоличествоЭлементов));
Сообщить("yaml-bytes=" + Строка(СтрДлина(Yaml)));
Сообщить("items-parsed=" + Строка(Элементы.Количество()));
