#Использовать ".."

Функция БольшойОбъект(КоличествоЭлементов)
	Документ = Новый Соответствие();
	Элементы = Новый Массив();
	
	Для Индекс = 1 По КоличествоЭлементов Цикл
		Элемент = Новый Соответствие();
		Элемент.Вставить("id", Индекс);
		Элемент.Вставить("name", "item-" + Строка(Индекс));
		Элемент.Вставить("enabled", Истина);
		
		Метки = Новый Массив();
		Метки.Добавить("build");
		Метки.Добавить("test");
		Элемент.Вставить("labels", Метки);
		
		Лимиты = Новый Соответствие();
		Лимиты.Вставить("cpu", Индекс % 16 + 1);
		Лимиты.Вставить("memory", Индекс % 64 + 128);
		Элемент.Вставить("limits", Лимиты);
		
		Элементы.Добавить(Элемент);
	КонецЦикла;
	
	Документ.Вставить("items", Элементы);
	Возврат Документ;
КонецФункции

КоличествоЭлементов = 5000;
Парсер = Новый ПарсерYaml();
Документ = БольшойОбъект(КоличествоЭлементов);
Yaml = Парсер.ЗаписатьYaml(Документ);

Если СтрДлина(Yaml) = 0 Тогда
	ВызватьИсключение "Сериализация вернула пустую строку";
КонецЕсли;

Сообщить("items=" + Строка(КоличествоЭлементов));
Сообщить("serialized-bytes=" + Строка(СтрДлина(Yaml)));
